# Supabase Configuration
# Get these values from: Supabase Dashboard → Settings → API

# Project URL (例: https://abcdefghijklmnop.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
i
# Anon/Public Key (例: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================
# 注意事項
# ===========================
#
# 1. このファイルをコピーして .env ファイルを作成してください:
#    cp .env.example .env
#
# 2. .env ファイルに実際の値を記入してください
#
# 3. .env ファイルは絶対にGitにコミットしないでください
#    （.gitignore に含まれています）
#
# 4. AI API Keys は Supabase Edge Functions のシークレットとして設定します:
#
#    【優先順位】OpenAI → Gemini 1 → Gemini 2 → Gemini 3 → Gemini 4
#
#    # OpenAI API Key (優先)
#    supabase secrets set OPENAI_API_KEY=your-openai-api-key
#
#    # Gemini API Keys (フォールバック用、4つまで設定可能)
#    supabase secrets set GEMINI_API_KEY_1=your-gemini-api-key-1
#    supabase secrets set GEMINI_API_KEY_2=your-gemini-api-key-2
#    supabase secrets set GEMINI_API_KEY_3=your-gemini-api-key-3
#    supabase secrets set GEMINI_API_KEY_4=your-gemini-api-key-4
#
#    ※ すべてのキーを設定する必要はありません。設定されたキーを順番に試します。
#    ※ すべてのAPIが失敗した場合のみエラーが返されます。
#
